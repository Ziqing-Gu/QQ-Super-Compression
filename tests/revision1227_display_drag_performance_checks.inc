    static void displayDragPerformanceChecks (const juce::File& root)
    {
        (void) root;
        QQSuperCompressionAudioProcessor p;
        baseline (p);
        QQSuperCompressionAudioProcessorEditor e (p, settings (root));
        auto& display = e.display;

        constexpr double sr = 48000.0;
        constexpr uint64_t ref = 480000;
        constexpr float width = 800.0f;

        const auto newest = QQSCVisualCheck::historyXForTest (display, ref, ref, sr, width);
        const auto oneSecondOld = QQSCVisualCheck::historyXForTest (display, ref, ref - 48000, sr, width);
        const auto eightSecondsOld = QQSCVisualCheck::historyXForTest (display, ref, ref - 384000, sr, width);
        const auto olderThanWindow = QQSCVisualCheck::historyXForTest (display, ref, 0, sr, width);

        check (std::abs (newest - width) < 0.01f, "Newest Display point must stay at the right edge");
        check (std::abs (oneSecondOld - width * 7.0f / 8.0f) < 0.05f,
               "Display x-axis is not audio-time based");
        check (std::abs (eightSecondsOld) < 0.05f,
               "Eight-second history must reach the left edge");
        check (std::abs (olderThanWindow) < 0.05f,
               "Old history must clamp to the left edge");

        const auto kept = QQSCVisualCheck::trimHistoryForTest (
            display, ref, sr, { ref - 430000, ref - 383999, ref - 240000, ref });
        check (kept == 3, "Audio-time history trimming did not keep exactly the visible eight-second window");

        // The counter is generated by the display-history ring at
        // min(host sample rate, 48 kHz). The timeline must use that exact rate,
        // not the host rate, otherwise 96/192 kHz sessions would scroll slowly.
        QQSuperCompressionAudioProcessor rateProbe;
        rateProbe.setDisplayKeyHistoryCaptureEnabled (true);
        rateProbe.prepareToPlay (44100.0, 256);
        check (std::abs (rateProbe.getDisplayKeyHistoryPosition().sampleRate - 44100.0) < 0.01,
               "44.1 kHz display-history counter rate is incorrect");
        rateProbe.prepareToPlay (96000.0, 256);
        check (std::abs (rateProbe.getDisplayKeyHistoryPosition().sampleRate - 48000.0) < 0.01,
               "96 kHz host must expose the 48 kHz display-history counter rate");
        rateProbe.releaseResources();
        rateProbe.setDisplayKeyHistoryCaptureEnabled (false);

        // Bulk LUT projection must remain numerically identical to the scalar
        // Display law across representative Classic/Super, Single/Dual and
        // Limiter/Normal states.
        const std::array<float, 9> levels {
            0.0f, 0.0001f, 0.003f, 0.01f, 0.05f, 0.1f, 0.25f, 0.7f, 1.0f
        };
        std::array<float, 9> bulk {};

        for (int limiter : { 0, 1 })
        {
            set (p, "limiterMode", static_cast<float> (limiter));
            for (int dual : { 0, 1 })
            {
                set (p, p.soundParameterID (qqsc::params::compressionMode), static_cast<float> (dual));
                for (int algorithm : { 0, 1 })
                {
                    set (p, p.soundParameterID (qqsc::params::algorithmMode), static_cast<float> (algorithm));
                    if (dual)
                    {
                        set (p, p.soundParameterID (qqsc::params::upEnabledIds[0]), 1.0f);
                        set (p, p.soundParameterID (qqsc::params::downEnabledIds[0]), 1.0f);
                        set (p, p.soundParameterID (qqsc::params::upRatioIds[0]), limiter ? 0.25f : 0.5f);
                        set (p, p.soundParameterID (qqsc::params::downRatioIds[0]), limiter ? 400.0f : 5.0f);
                        set (p, p.soundParameterID (qqsc::params::upThresholdIds[0]), -36.0f);
                        set (p, p.soundParameterID (qqsc::params::downThresholdIds[0]), -12.0f);
                        set (p, p.soundParameterID ("upAlgorithmMode"), static_cast<float> (algorithm));
                        set (p, p.soundParameterID ("downAlgorithmMode"), static_cast<float> (algorithm));
                    }
                    else
                    {
                        set (p, p.soundParameterID (qqsc::params::ratioIds[0]), limiter ? 8.0f : 5.0f);
                        set (p, p.soundParameterID (qqsc::params::thresholdIds[0]), -24.0f);
                        set (p, p.soundParameterID (qqsc::params::rangeIds[0]), 1.0f);
                    }

                    p.fillDynamicsGainForDomain (levels.data(), bulk.data(), bulk.size(), 0);

                    const bool isDual = p.readSoundParameter (qqsc::params::compressionMode) >= 0.5f;
                    const bool isLimiter = p.isLimiterMode();
                    const auto lower = qqsc::params::thresholdLinear (
                        p.getBoundaryForDomainDb (isDual, false, 0));
                    const auto upperDb = p.getBoundaryForDomainDb (isDual, true, 0);
                    const auto upper = isDual ? qqsc::params::thresholdLinear (upperDb)
                                              : qqsc::params::rangeLinear (upperDb);

                    const auto singleAlgorithm = p.readSoundParameter (qqsc::params::algorithmMode) < 0.5f
                        ? qqsc::CompressionAlgorithm::classic : qqsc::CompressionAlgorithm::super;
                    const auto upAlgorithm = p.readSoundParameter ("upAlgorithmMode") < 0.5f
                        ? qqsc::CompressionAlgorithm::classic : qqsc::CompressionAlgorithm::super;
                    const auto downAlgorithm = p.readSoundParameter ("downAlgorithmMode") < 0.5f
                        ? qqsc::CompressionAlgorithm::classic : qqsc::CompressionAlgorithm::super;

                    const auto singleRatio = qqsc::params::limiterRatio (
                        p.readSoundParameter (qqsc::params::ratioIds[0]), isLimiter);
                    const auto upRatio = p.readSoundParameter (qqsc::params::upEnabledIds[0]) >= 0.5f
                        ? qqsc::params::upwardRatio (p.readSoundParameter (qqsc::params::upRatioIds[0]), isLimiter)
                        : 1.0f;
                    const auto downRatio = p.readSoundParameter (qqsc::params::downEnabledIds[0]) >= 0.5f
                        ? qqsc::params::limiterRatio (p.readSoundParameter (qqsc::params::downRatioIds[0]), isLimiter, true)
                        : 1.0f;

                    for (size_t i = 0; i < levels.size(); ++i)
                    {
                        const auto expected = isDual
                            ? qqsc::StaticCompressionEngine::dualGainForLevel (
                                levels[i], upRatio, downRatio, lower, upper, upAlgorithm, downAlgorithm)
                            : qqsc::StaticCompressionEngine::singleGainForLevel (
                                levels[i], singleRatio, lower, upper, singleAlgorithm);
                        const auto scalar = p.getDynamicsGainForDomain (levels[i], 0);
                        check (std::abs (bulk[i] - scalar) < 1.0e-7f,
                               "Bulk Display LUT law differs from the established scalar projection law");
                        check (std::abs (bulk[i] - expected) < 1.0e-7f,
                               "Bulk Display LUT law differs from the established static projection law");
                    }
                }
            }
        }

        std::cout
            << "PASS: 1.2.27 Display x-axis follows audio-history time across delayed UI ticks; "
               "eight-second trimming and bulk dynamics LUT projection preserve the established law.\\n";
    }
